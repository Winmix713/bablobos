{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "./dist",
    "target": "ES2020",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "downlevelIteration": true
  },
  "include": [
    "lib/cli/**/*",
    "lib/plugins/**/*",
    "lib/converters/**/*",
    "lib/design-tokens/**/*",
    "lib/accessibility/**/*",
    "lib/cache/**/*",
    "lib/utils/**/*",
    "types/**/*"
  ],
  "exclude": [
    "node_modules",
    "app/**/*",
    "components/**/*",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}